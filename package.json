{
  "name": "nimp",
  "version": "0.0.1",
  "description": "Nodejs image manipulation package",
  "main": "dist/index.js",
  "type": "module",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --import ./tests/setup.mjs --test ./dist/**/*.spec.js",
    "test:update": "tsc && node --import ./tests/setup.mjs --test --test-update-snapshots ./dist/**/*.spec.js",
    "lint": "tsc --noEmit && eslint ./src/**/*.ts",
    "lint:fix": "eslint ./src/**/*.ts --fix",
    "benchmark": "tsc && node ./dist/png/benchmarks/decoder/index.bench.js"
  },
  "keywords": [
    "png",
    "encoder",
    "decoder"
  ],
  "author": "Boykiv Bogdan <boikiv.bogdan@gmail.com>",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/blackPavlin/nimp.git"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/benchmark": "^2.1.5",
    "@types/node": "^25.0.3",
    "@types/pngjs": "^6.0.5",
    "benchmark": "^2.1.4",
    "eslint": "^9.39.2",
    "husky": "^9.1.6",
    "lint-staged": "^15.3.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0"
  },
  "lint-staged": {
    "*.ts": [
      "npm run lint",
      "npm run test"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
